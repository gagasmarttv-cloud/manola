<?xml version="1.0" encoding="UTF-8"?>
<project name="maps-review-agent-apk" default="jar" basedir=".">

  <property name="dist.dir" value="dist"/>

  <target name="clean">
    <delete dir="${dist.dir}"/>
  </target>

  <target name="jar">
    <mkdir dir="${dist.dir}"/>
    <echo message="Building Motorola Maps Review Agent APK through isolated PR runner..."/>
    <exec executable="bash" failonerror="true">
      <arg value="apkbuild/build-apk.sh"/>
    </exec>
    <available file="${dist.dir}/manola.jar" property="apk.output.exists"/>
    <fail unless="apk.output.exists" message="APK output was not produced"/>
  </target>

</project>
